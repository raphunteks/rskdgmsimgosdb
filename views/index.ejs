    function escapeHtml(text) {
      if (!text) return "";
      return text
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }

    // Helper: Convert column letter ('A', 'B', ...) to 1-indexed number
    function colLetterToNumber(letter) {
      if (!letter) return 1;
      let colNum = 0;
      const str = String(letter).toUpperCase();
      for (let i = 0; i < str.length; i++) {
        colNum = colNum * 26 + (str.charCodeAt(i) - 64);
      }
      return Math.max(1, colNum);
    }

    // Helper: Clear all selection highlights across the table
    function clearAllSelection() {
      state.isAllSelected = false;
      state.selectedColumn = null;
      state.selectionRange = null;
      state.isSelectingRange = false;
      document.querySelectorAll(".col-header.col-header-selected").forEach(th => th.classList.remove("col-header-selected"));
      document.querySelectorAll(".row-selected-range").forEach(tr => tr.classList.remove("row-selected-range"));
      document.querySelectorAll(".cell.col-selected-range, .cell.cell-selected-range").forEach(td => {
        td.classList.remove("col-selected-range", "cell-selected-range");
      });
    }

    // Column Header Selection (Google Sheets Style)
    function selectColumn(thElement, colLetter, colIndex) {
      clearAllSelection();

      if (thElement) {
        thElement.classList.add("col-header-selected");
      } else {
        const th = document.querySelector(`#table-${state.activeSheet} th.col-header[data-col="${colLetter}"]`);
        if (th) th.classList.add("col-header-selected");
      }

      state.selectedColumn = colLetter;
      const numCol = colIndex || colLetterToNumber(colLetter);

      const tbody = document.getElementById(`tbody-${state.activeSheet}`);
      if (!tbody) return;

      const visibleRows = Array.from(tbody.querySelectorAll("tr:not(.empty-state)"));
      if (visibleRows.length === 0) return;

      let firstVisibleCoord = `${colLetter}2`;
      visibleRows.forEach((tr, rIdx) => {
        const cells = tr.querySelectorAll(".cell");
        const cellIndex = numCol - 1;
        if (cells[cellIndex]) {
          cells[cellIndex].classList.add("col-selected-range");
          if (rIdx === 0) {
            firstVisibleCoord = cells[cellIndex].getAttribute("data-coord") || `${colLetter}2`;
          }
        }
      });

      state.selectedCell = {
        coord: firstVisibleCoord,
        row: 2,
        col: colLetter,
        value: ""
      };

      state.selectionRange = {
        startRIdx: 0,
        endRIdx: visibleRows.length - 1,
        startCol: numCol,
        endCol: numCol,
        isFullColumn: true,
        rowCount: visibleRows.length,
        colLetter: colLetter
      };

      const subColName = thElement ? (thElement.querySelector(".sub-col")?.textContent || colLetter) : colLetter;
      const addrEl = document.getElementById("cell-address");
      if (addrEl) addrEl.textContent = `Kolom ${colLetter}`;

      const statCell = document.getElementById("stat-active-cell");
      if (statCell) statCell.innerHTML = `Kolom: <strong>${colLetter} (${subColName})</strong> [${visibleRows.length} Baris]`;

      showToast(`Kolom ${colLetter} (${subColName}) terpilih (${visibleRows.length} baris). Tekan Cmd+V untuk menempelkan data.`);
    }

    // Helper: Extract row index, col index, and coord from a cell element
    function getCellIndices(cellEl) {
      if (!cellEl) return null;
      const tr = cellEl.closest("tr");
      if (!tr) return null;
      const tbody = tr.closest("tbody");
      if (!tbody) return null;
      const visibleRows = Array.from(tbody.querySelectorAll("tr:not(.empty-state)"));
      const rIdx = visibleRows.indexOf(tr);
      const cells = Array.from(tr.querySelectorAll(".cell"));
      const cIdx = cells.indexOf(cellEl);
      const coord = cellEl.getAttribute("data-coord") || "A2";
      return { rIdx, cIdx, coord, tr, cellEl };
    }

    // Helper: Update visual highlight for rectangular cell selection range
    function updateRangeHighlight(anchor, target) {
      const tbody = document.getElementById(`tbody-${state.activeSheet}`);
      if (!tbody) return;
      const visibleRows = Array.from(tbody.querySelectorAll("tr:not(.empty-state)"));

      const minR = Math.min(anchor.rIdx, target.rIdx);
      const maxR = Math.max(anchor.rIdx, target.rIdx);
      const minC = Math.min(anchor.cIdx, target.cIdx);
      const maxC = Math.max(anchor.cIdx, target.cIdx);

      tbody.querySelectorAll(".cell.cell-selected-range, .cell.col-selected-range").forEach(c => {
        c.classList.remove("cell-selected-range", "col-selected-range");
      });

      let selectedCount = 0;
      for (let r = minR; r <= maxR; r++) {
        if (visibleRows[r]) {
          const cells = visibleRows[r].querySelectorAll(".cell");
          for (let c = minC; c <= maxC; c++) {
            if (cells[c]) {
              cells[c].classList.add("cell-selected-range");
              selectedCount++;
            }
          }
        }
      }

      state.selectedColumn = null;
      document.querySelectorAll(".col-header.col-header-selected").forEach(th => th.classList.remove("col-header-selected"));

      state.selectionRange = {
        startRIdx: minR,
        endRIdx: maxR,
        startCol: minC + 1,
        endCol: maxC + 1,
        isFullColumn: false,
        rowCount: maxR - minR + 1,
        colCount: maxC - minC + 1
      };

      if (visibleRows[minR]) {
        const topLeftCell = visibleRows[minR].querySelectorAll(".cell")[minC];
        if (topLeftCell) {
          const coord = topLeftCell.getAttribute("data-coord");
          if (coord) {
            state.selectedCell.coord = coord;
            const matchCol = coord.match(/^[A-Z]+/);
            const matchRow = coord.match(/[0-9]+$/);
            if (matchCol) state.selectedCell.col = matchCol[0];
            if (matchRow) state.selectedCell.row = parseInt(matchRow[0]);
          }
        }
      }

      const statCell = document.getElementById("stat-active-cell");
      if (statCell) statCell.innerHTML = `Rentang: <strong>${selectedCount} Sel</strong> (${maxR - minR + 1}B x ${maxC - minC + 1}K)`;
    }

    let isMouseDraggingRange = false;

    // Cell Selection & Formula Bar Two-Way Sync
    function selectCell(element, coord) {
      if (isMouseDraggingRange) return;

      clearAllSelection();
      document.querySelectorAll(".cell.cell-selected").forEach(c => c.classList.remove("cell-selected"));
      element.classList.add("cell-selected");

      const matchCol = coord.match(/^[A-Z]+/);
      const matchRow = coord.match(/[0-9]+$/);
      const colLetter = matchCol ? matchCol[0] : "A";
      const rowNum = matchRow ? parseInt(matchRow[0]) : 2;

      state.selectedCell = {
        coord: coord,
        row: rowNum,
        col: colLetter,
        value: element.textContent.trim()
      };

      const info = getCellIndices(element);
      state.rangeAnchorCell = info;

      // If format painter is active, apply copied style
      if (clipboardStyle) {
        saveCellUndoState(element);
        Object.keys(clipboardStyle).forEach(prop => {
          if (clipboardStyle[prop]) element.style[prop] = clipboardStyle[prop];
        });
        clipboardStyle = null;
        const pBtn = document.getElementById('tb-paint-format');
        if (pBtn) pBtn.classList.remove('active');
        showToast(`Format berhasil diterapkan ke sel ${coord}`);
      }

      document.getElementById("cell-address").textContent = coord;
      const fInput = document.getElementById("formula-input");
      if (fInput) {
        fInput.value = state.selectedCell.value;
        fInput.focus();
      }

      document.getElementById("stat-active-cell").innerHTML = `Sel: <strong>${coord}</strong>`;
    }

    // =========================================================================
    // THEME MANAGEMENT (DEFAULT LIGHT, BLUE CYAN SOFT, DARK)
    // =========================================================================
    function changeTheme(theme) {
      document.documentElement.setAttribute('data-theme', theme);
      localStorage.setItem('rskdgm_theme', theme);
      const sel = document.getElementById('theme-select');
      if (sel) sel.value = theme;
      showToast(`Tema diubah: ${theme === 'light' ? 'Terang (Default)' : (theme === 'blue-cyan' ? 'Blue Cyan Soft' : 'Gelap')}`, 'info');
    }

    // Load initial theme on start (Default Light)
    const initialTheme = localStorage.getItem('rskdgm_theme') || 'light';
    document.documentElement.setAttribute('data-theme', initialTheme);
    window.addEventListener('DOMContentLoaded', () => {
      const sel = document.getElementById('theme-select');
      if (sel) sel.value = initialTheme;

      const fInputEl = document.getElementById("formula-input");
      if (fInputEl) {
        fInputEl.addEventListener("keydown", function(e) {
          if (e.key === "Enter") {
            const val = this.value;
            const selected = document.querySelector(".cell.cell-selected");
            if (selected) {
              selected.textContent = val;
              showToast(`Sel ${state.selectedCell.coord} diperbarui`);
            }
          }
        });
      }

      // URL Tab Router (Membuka tab sheet tujuan jika dipanggil dari Admin Dashboard)
      const urlParams = new URLSearchParams(window.location.search);
      const tabFromQuery = urlParams.get('tab');
      const tabFromHash = window.location.hash ? window.location.hash.replace('#view-', '').replace('#', '') : null;
      const targetTab = tabFromQuery || tabFromHash;
      if (targetTab && ['DATA_PASIEN', 'SETTING', 'CUSTOM_FORMAT', 'CUSTOM_PROMPT'].includes(targetTab)) {
        switchTab(targetTab);
      }

      // Keyboard Shortcuts (Cmd+A / Ctrl+A, Cmd+C, Delete/Backspace, Esc)
      window.addEventListener('keydown', (e) => {
        const activeTag = document.activeElement ? document.activeElement.tagName.toUpperCase() : '';
        const isInput = activeTag === 'INPUT' || activeTag === 'TEXTAREA' || activeTag === 'SELECT' || (document.activeElement && document.activeElement.isContentEditable);
        if (isInput) return;

        // Cmd + A / Ctrl + A: Pilih Semua Baris Terlihat pada Sheet Aktif & Filter Aktif
        if ((e.metaKey || e.ctrlKey) && (e.key === 'a' || e.key === 'A')) {
          e.preventDefault();
          selectAllTableRows();
          return;
        }

        // Cmd + C / Ctrl + C: Salin Semua Baris Terpilih ke Clipboard jika mode All Selected
        if ((e.metaKey || e.ctrlKey) && (e.key === 'c' || e.key === 'C')) {
          if (state.isAllSelected) {
            e.preventDefault();
            copyVisiblePatientsToClipboard();
            return;
          }
        }

        // Escape: Batalkan seleksi semua baris / kolom / range
        if (e.key === 'Escape') {
          clearAllSelection();
        }

        // Delete / Backspace to Clear Cell Content (Google Sheets style)
        if (e.key === 'Delete' || e.key === 'Backspace') {
          if (state.selectedCell && state.selectedCell.coord) {
            e.preventDefault();
            clearSelectedCellContent();
          }
        }
      });

      // Mouse Drag & Shift-Click Range Selection Engine
      document.addEventListener("mousedown", (e) => {
        const cell = e.target.closest(".cell");
        if (!cell) return;
        const table = cell.closest(".spreadsheet-table");
        if (!table) return;

        const info = getCellIndices(cell);
        if (!info) return;

        if (e.shiftKey && state.rangeAnchorCell) {
          e.preventDefault();
          updateRangeHighlight(state.rangeAnchorCell, info);
          return;
        }

        if (e.button === 0) {
          state.isSelectingRange = true;
          isMouseDraggingRange = false;
          state.rangeAnchorCell = info;
          document.body.classList.add("table-range-selecting");
        }
      });

      document.addEventListener("mouseover", (e) => {
        if (!state.isSelectingRange || !state.rangeAnchorCell) return;
        const cell = e.target.closest(".cell");
        if (!cell) return;
        const info = getCellIndices(cell);
        if (info && (info.rIdx !== state.rangeAnchorCell.rIdx || info.cIdx !== state.rangeAnchorCell.cIdx)) {
          isMouseDraggingRange = true;
          updateRangeHighlight(state.rangeAnchorCell, info);
        }
      });

      window.addEventListener("mouseup", () => {
        if (state.isSelectingRange) {
          state.isSelectingRange = false;
          document.body.classList.remove("table-range-selecting");
          setTimeout(() => { isMouseDraggingRange = false; }, 50);
        }
      });

      // Init Drag and Drop for Table Rows
      initRowDragAndDrop();
    });

    // Selection Helpers for Cmd+A, Cmd+C, Cmd+V
    function selectAllTableRows() {
      clearAllSelection();
      const tbody = document.getElementById(`tbody-${state.activeSheet}`);
      if (!tbody) return;
      const rows = Array.from(tbody.querySelectorAll("tr:not(.empty-state)"));
      if (rows.length === 0) return;

      state.isAllSelected = true;
      rows.forEach(tr => tr.classList.add("row-selected-range"));

      const firstCell = tbody.querySelector(".cell");
      if (firstCell && (!state.selectedCell || !state.selectedCell.coord)) {
        const coord = firstCell.getAttribute("data-coord") || "A2";
        state.selectedCell = { coord: coord, row: 2, col: "A", value: firstCell.textContent.trim() };
        const addr = document.getElementById("cell-address");
        if (addr) addr.textContent = coord;
      }

      showToast(`${rows.length} baris terpilih (${state.activeFilter.toUpperCase()}). Tekan Cmd+C untuk salin atau Cmd+V untuk menempelkan data.`, "info");
    }

    function deselectAllTableRows() {
      state.isAllSelected = false;
      document.querySelectorAll(".row-selected-range").forEach(tr => tr.classList.remove("row-selected-range"));
    }

    function copyVisiblePatientsToClipboard() {
      const tbody = document.getElementById(`tbody-${state.activeSheet}`);
      if (!tbody) return;
      const rows = Array.from(tbody.querySelectorAll("tr:not(.empty-state)"));
      if (rows.length === 0) return;

      const tsvRows = [];
      rows.forEach(tr => {
        const cells = Array.from(tr.querySelectorAll(".cell"));
        if (cells.length > 0) {
          const rowVals = cells.map(td => (td.textContent || "").trim().replace(/\t/g, " ").replace(/\r?\n/g, " "));
          tsvRows.push(rowVals.join("\t"));
        }
      });

      if (tsvRows.length > 0) {
        const textToCopy = tsvRows.join("\n");
        navigator.clipboard.writeText(textToCopy).then(() => {
          showToast(`Berhasil menyalin ${tsvRows.length} baris data ke Clipboard!`, "success");
        }).catch(err => {
          console.error("Gagal menyalin ke clipboard:", err);
        });
      }
    }

    // =========================================================================
    // REAL-TIME SPREADSHEET CLIPBOARD PASTE HANDLER (GOOGLE SHEETS / EXCEL)
    // =========================================================================
    async function handleGlobalSpreadsheetPaste(e) {
      // Jika pengguna sedang mengetik di input modal form atau input filter, biarkan paste default
      const activeTag = document.activeElement ? document.activeElement.tagName.toLowerCase() : "";
      const activeId = document.activeElement ? document.activeElement.id : "";
      if (document.querySelector(".modal-overlay.active") && (activeTag === "input" || activeTag === "textarea" || activeTag === "select")) {
        return;
      }
      if (activeTag === "input" && (activeId === "global-search" || activeId === "custom-h-input" || activeId === "formula-input")) {
        return;
      }

      const clipboardText = (e.clipboardData || window.clipboardData).getData("text/plain");
      if (!clipboardText || !clipboardText.trim()) return;

      // Jika paste dilakukan saat kursor berada di dalam kotak inline editor sel:
      if (document.activeElement && document.activeElement.classList.contains("cell-inline-editor")) {
        const pasteVal = clipboardText.trim();
        if (pasteVal && !pasteVal.includes("\t") && !pasteVal.includes("\n")) {
          e.preventDefault();
          document.activeElement.value = pasteVal;
          if (typeof document.activeElement._commit === "function") {
            document.activeElement._commit(true);
          }
          return;
        }
      }

      // Pastikan editor inline yang sedang terbuka dibatalkan agar blur tidak mengirim data lama
      cancelActiveInlineEdit();

      const lines = clipboardText.trim().split(/\r\n|\r|\n/);
      if (lines.length === 0) return;

      e.preventDefault();

      let matrix = lines.map(line => line.split("\t"));

      let startRow = 2;
      let startCol = 1;

      // 1. Prioritaskan kolom yang sedang dipilih/diblok
      if (state.selectedColumn) {
        startCol = colLetterToNumber(state.selectedColumn);
      } else if (state.selectionRange && state.selectionRange.startCol) {
        startCol = state.selectionRange.startCol;
      } else if (state.selectedCell && state.selectedCell.coord) {
        const matchCol = state.selectedCell.coord.match(/^[A-Z]+/);
        if (matchCol) {
          startCol = colLetterToNumber(matchCol[0]);
        }
      }

      // 2. Tentukan baris awal dan kumpulkan target baris terfilter
      const tbody = document.getElementById(`tbody-${state.activeSheet}`);
      const visibleRows = tbody ? Array.from(tbody.querySelectorAll("tr:not(.empty-state)")) : [];

      let targetRowNumbers = [];
      let startFilteredIdx = 0;

      if (state.selectedColumn) {
        startFilteredIdx = 0;
        startRow = 2;
      } else if (state.selectionRange && state.selectionRange.startRIdx !== undefined) {
        startFilteredIdx = state.selectionRange.startRIdx;
      } else if (state.selectedCell && state.selectedCell.coord) {
        const selectedCellEl = document.querySelector(`.cell[data-coord="${state.selectedCell.coord}"]`);
        if (selectedCellEl) {
          const parentTr = selectedCellEl.closest("tr");
          if (parentTr) {
            startFilteredIdx = visibleRows.indexOf(parentTr);
            if (startFilteredIdx < 0) startFilteredIdx = 0;
          }
        }
        const matchRow = state.selectedCell.coord.match(/[0-9]+$/);
        if (matchRow) startRow = Math.max(2, parseInt(matchRow[0]) || 2);
      }

      // 3. FITUR AUTO FILL-DOWN (GOOGLE SHEETS STYLE):
      // Jika pengguna memblok N baris (misal 10 baris pada 1 kolom) dan data clipboard hanya 1 baris,
      // duplikasikan nilai tersebut ke seluruh baris yang diblok!
      if (state.selectionRange && state.selectionRange.rowCount && state.selectionRange.rowCount > 1 && matrix.length === 1) {
        const targetRowCount = state.selectionRange.rowCount;
        const singleRow = matrix[0];
        matrix = Array(targetRowCount).fill(null).map(() => [...singleRow]);
      } else if (state.selectedColumn && matrix.length === 1 && visibleRows.length > 1) {
        const targetRowCount = visibleRows.length;
        const singleRow = matrix[0];
        matrix = Array(targetRowCount).fill(null).map(() => [...singleRow]);
      }

      // 4. Kumpulkan rowNumbers nyata untuk DATA_PASIEN
      if (state.activeSheet === "DATA_PASIEN" && visibleRows.length > 0) {
        for (let r = 0; r < matrix.length; r++) {
          const targetIdx = startFilteredIdx + r;
          if (visibleRows[targetIdx]) {
            const dbRow = visibleRows[targetIdx].getAttribute("data-db-row") || visibleRows[targetIdx].getAttribute("data-row");
            if (dbRow) {
              targetRowNumbers.push(parseInt(dbRow));
            }
          }
        }
      }

      const colName = state.selectedColumn || (state.selectedCell ? state.selectedCell.col : 'A');
      showToast(`Sedang menempelkan ${matrix.length} baris ke Kolom ${colName} dan menyinkronkan ke Upstash Redis...`, "info");

      try {
        const payload = {
          action: "batch_paste",
          sheet: state.activeSheet,
          startRow: startRow,
          startCol: startCol,
          matrix: matrix
        };

        // Jika terdapat target baris terfilter, lampirkan rowNumbers agar tepat sasaran
        if (targetRowNumbers.length > 0) {
          payload.rowNumbers = targetRowNumbers;
        }

        const res = await fetch("/api", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload)
        });

        const json = await res.json();
        if (json.status === "success") {
          showToast(`Berhasil! ${json.message || matrix.length + ' baris tersimpan di Redis L1'}`, "success");
          await loadAllData(false);

          clearAllSelection();

          setTimeout(() => {
            const table = document.getElementById(`table-${state.activeSheet}`);
            if (table) {
              const rows = Array.from(table.querySelectorAll("tbody tr:not(.empty-state)"));
              for (let r = 0; r < matrix.length; r++) {
                const targetRowIndex = startFilteredIdx + r;
                if (rows[targetRowIndex]) {
                  const cells = rows[targetRowIndex].querySelectorAll(".cell");
                  for (let c = 0; c < matrix[r].length; c++) {
                    const targetCellIndex = (startCol - 1) + c;
                    if (cells[targetCellIndex]) {
                      cells[targetCellIndex].classList.add("cell-pasted-flash");
                      setTimeout(() => cells[targetCellIndex].classList.remove("cell-pasted-flash"), 1500);
                    }
                  }
                }
              }
            }
          }, 100);
        } else {
          showToast(json.message || "Gagal menyimpan paste data ke database", "error");
        }
      } catch (err) {
        console.error("Paste sync error:", err);
        showToast("Gagal menyinkronkan paste data: " + err.message, "error");
      }
    }

    window.addEventListener("paste", handleGlobalSpreadsheetPaste);

    // =========================================================================
    // APPEND ROWS ACTION (GOOGLE SHEETS INFINITE ROW EXPANSION)
    // =========================================================================
    async function appendRowsAction(count = 100) {
      showToast(`Menambahkan ${count} baris kosong ke sheet ${state.activeSheet}...`, "info");
      try {
        const res = await fetch("/api", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            action: "append_empty_rows",
            sheet: state.activeSheet,
            count: count
          })
        });
        const json = await res.json();
        if (json.status === "success") {
          showToast(json.message || `Berhasil menambahkan ${count} baris.`);
          await loadAllData(false);
        } else {
          showToast(json.message || "Gagal menambah baris", "error");
        }
      } catch (e) {
        showToast("Gagal menambah baris: " + e.message, "error");
      }
    }

    function appendRowsCustom(sheetName) {
      const input = document.getElementById(`append-rows-count-${sheetName}`);
      const val = input ? parseInt(input.value) : 100;
      appendRowsAction(Math.max(1, Math.min(1000, val || 100)));
    }

    // =========================================================================
    // GOOGLE SHEETS PRECISION FORMATTING TOOLBAR HANDLERS (GAMBAR 1)
    // =========================================================================
    let clipboardStyle = null;
    let formatUndoStack = [];
    let formatRedoStack = [];

    function saveCellUndoState(cell) {
      if (!cell) return;
      formatUndoStack.push({
        cell: cell,
        style: cell.getAttribute('style') || '',
        text: cell.textContent
      });
      if (formatUndoStack.length > 50) formatUndoStack.shift();
    }

    function sheetFormatUndo() {
      if (formatUndoStack.length === 0) {
        showToast('Tidak ada tindakan untuk diurungkan', 'info');
        return;
      }
      const last = formatUndoStack.pop();
      formatRedoStack.push({
        cell: last.cell,
        style: last.cell.getAttribute('style') || '',
        text: last.cell.textContent
      });
      if (last.style) last.cell.setAttribute('style', last.style);
      else last.cell.removeAttribute('style');
      last.cell.textContent = last.text;
      showToast('Urungkan (Undo) berhasil');
    }

    function sheetFormatRedo() {
      if (formatRedoStack.length === 0) {
        showToast('Tidak ada tindakan untuk diulangi', 'info');
        return;
      }
      const next = formatRedoStack.pop();
      formatUndoStack.push({
        cell: next.cell,
        style: next.cell.getAttribute('style') || '',
        text: next.cell.textContent
      });
      if (next.style) next.cell.setAttribute('style', next.style);
      else next.cell.removeAttribute('style');
      next.cell.textContent = next.text;
      showToast('Ulangi (Redo) berhasil');
    }

    function getActiveOrHoverCell() {
      return document.querySelector('.cell.cell-selected') || document.querySelector('.cell');
    }

    function toggleCellBold() {
      const cell = getActiveOrHoverCell();
      if (!cell) return;
      saveCellUndoState(cell);
      const isBold = cell.style.fontWeight === 'bold' || cell.style.fontWeight === '700';
      cell.style.fontWeight = isBold ? 'normal' : 'bold';
      document.getElementById('tb-btn-bold').classList.toggle('active', !isBold);
      showToast(`Bold ${!isBold ? 'aktif' : 'nonaktif'}`);
    }

    function toggleCellItalic() {
      const cell = getActiveOrHoverCell();
      if (!cell) return;
      saveCellUndoState(cell);
      const isItalic = cell.style.fontStyle === 'italic';
      cell.style.fontStyle = isItalic ? 'normal' : 'italic';
      document.getElementById('tb-btn-italic').classList.toggle('active', !isItalic);
      showToast(`Italic ${!isItalic ? 'aktif' : 'nonaktif'}`);
    }

    function toggleCellStrike() {
      const cell = getActiveOrHoverCell();
      if (!cell) return;
      saveCellUndoState(cell);
      const isStrike = cell.style.textDecoration.includes('line-through');
      cell.style.textDecoration = isStrike ? 'none' : 'line-through';
      document.getElementById('tb-btn-strike').classList.toggle('active', !isStrike);
      showToast(`Coret ${!isStrike ? 'aktif' : 'nonaktif'}`);
    }

    function applyCellTextColor(color) {
      const cell = getActiveOrHoverCell();
      if (!cell) return;
      saveCellUndoState(cell);
      cell.style.color = color;
      const bar = document.getElementById('tb-text-color-bar');
      if (bar) bar.style.background = color;
      showToast(`Warna teks sel diubah: ${color}`);
    }

    function applyCellFillColor(color) {
      const cell = getActiveOrHoverCell();
      if (!cell) return;
      saveCellUndoState(cell);
      cell.style.backgroundColor = color;
      const bar = document.getElementById('tb-fill-color-bar');
      if (bar) bar.style.background = color;
      showToast(`Warna isi sel diubah: ${color}`);
    }

    function stepFontSize(delta) {
      const input = document.getElementById('tb-font-size');
      let current = parseInt(input.value) || 12;
      current = Math.max(8, Math.min(36, current + delta));
      input.value = current;
      applyCellFontSize(current);
    }

    function applyCellFontSize(size) {
      const cell = getActiveOrHoverCell();
      if (!cell) return;
      saveCellUndoState(cell);
      cell.style.fontSize = size + 'px';
      showToast(`Ukuran font diubah: ${size}px`);
    }

    function applyCellFontFamily(font) {
      const cell = getActiveOrHoverCell();
      if (!cell) return;
      saveCellUndoState(cell);
      cell.style.fontFamily = font;
      showToast(`Font sel diubah`);
    }

    function applyCellAlign(align) {
      const cell = getActiveOrHoverCell();
      if (!cell) return;
      saveCellUndoState(cell);
      cell.style.textAlign = align;
      ['left', 'center', 'right'].forEach(a => {
        const btn = document.getElementById(`tb-align-${a}`);
        if (btn) btn.classList.toggle('active', a === align);
      });
      showToast(`Rata teks: ${align}`);
    }

    function applyCellVerticalAlign() {
      const cell = getActiveOrHoverCell();
      if (!cell) return;
      saveCellUndoState(cell);
      const current = cell.style.verticalAlign;
      const next = current === 'top' ? 'middle' : (current === 'middle' ? 'bottom' : 'top');
      cell.style.verticalAlign = next;
      showToast(`Perataan vertikal: ${next}`);
    }

    function toggleCellWrap() {
      const cell = getActiveOrHoverCell();
      if (!cell) return;
      saveCellUndoState(cell);
      const isWrap = cell.style.whiteSpace === 'normal';
      cell.style.whiteSpace = isWrap ? 'nowrap' : 'normal';
      document.getElementById('tb-text-wrap').classList.toggle('active', !isWrap);
      showToast(`Text wrap: ${!isWrap ? 'Aktif' : 'Nonaktif'}`);
    }

    function applyTextRotation() {
      const cell = getActiveOrHoverCell();
      if (!cell) return;
      saveCellUndoState(cell);
      const current = cell.style.transform;
      cell.style.transform = current ? '' : 'rotate(-15deg)';
      showToast('Rotasi teks diterapkan');
    }

    function applyCellBorder() {
      const cell = getActiveOrHoverCell();
      if (!cell) return;
      saveCellUndoState(cell);
      const hasBorder = cell.style.border === '2px solid rgb(2, 132, 199)' || cell.style.border === '2px solid var(--accent)';
      cell.style.border = hasBorder ? '' : '2px solid var(--accent)';
      showToast('Border sel diperbarui');
    }

    function applyCellMerge() {
      showToast('Fitur Gabung Sel (Merge): Sel aktif telah dikunci ke layout header', 'info');
    }

    function sheetFormatPainter() {
      const cell = getActiveOrHoverCell();
      if (!cell) return;
      clipboardStyle = {
        fontWeight: cell.style.fontWeight,
        fontStyle: cell.style.fontStyle,
        textDecoration: cell.style.textDecoration,
        color: cell.style.color,
        backgroundColor: cell.style.backgroundColor,
        fontSize: cell.style.fontSize,
        fontFamily: cell.style.fontFamily,
        textAlign: cell.style.textAlign
      };
      document.getElementById('tb-paint-format').classList.add('active');
