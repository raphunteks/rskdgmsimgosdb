    // =========================================================================
    // DRAG-AND-DROP ROW REORDERING (GOOGLE SHEETS STYLE)
    // =========================================================================
    let dragSrcRow = null;
    let dragSheetName = null;
    let dragSrcIdx = -1;

    function initRowDragAndDrop() {
      ['tbody-DATA_PASIEN', 'tbody-SETTING', 'tbody-CUSTOM_FORMAT', 'tbody-CUSTOM_PROMPT'].forEach(tbodyId => {
        const tbody = document.getElementById(tbodyId);
        if (!tbody) return;

        tbody.addEventListener('dragstart', (e) => {
          const row = e.target.closest('tr[draggable="true"]');
          if (!row) return;
          dragSrcRow = row;
          dragSheetName = row.getAttribute('data-sheet');
          dragSrcIdx = parseInt(row.getAttribute('data-row-idx'), 10);
          row.classList.add('row-dragging');
          e.dataTransfer.effectAllowed = 'move';
          e.dataTransfer.setData('text/plain', String(dragSrcIdx));
        });

        tbody.addEventListener('dragover', (e) => {
          e.preventDefault();
          e.dataTransfer.dropEffect = 'move';
          const targetRow = e.target.closest('tr[draggable="true"]');
          if (!targetRow || targetRow === dragSrcRow) return;

          const rect = targetRow.getBoundingClientRect();
          const isBelow = (e.clientY - rect.top) / (rect.bottom - rect.top) > 0.5;

          tbody.querySelectorAll('tr').forEach(r => r.classList.remove('drag-over-top', 'drag-over-bottom'));
          if (isBelow) targetRow.classList.add('drag-over-bottom');
          else targetRow.classList.add('drag-over-top');
        });

        tbody.addEventListener('dragleave', (e) => {
          const targetRow = e.target.closest('tr');
          if (targetRow) targetRow.classList.remove('drag-over-top', 'drag-over-bottom');
        });

        tbody.addEventListener('dragend', () => {
          if (dragSrcRow) dragSrcRow.classList.remove('row-dragging');
          tbody.querySelectorAll('tr').forEach(r => r.classList.remove('drag-over-top', 'drag-over-bottom', 'row-dragging'));
          dragSrcRow = null;
        });

        tbody.addEventListener('drop', async (e) => {
          e.preventDefault();
          const targetRow = e.target.closest('tr[draggable="true"]');
          tbody.querySelectorAll('tr').forEach(r => r.classList.remove('drag-over-top', 'drag-over-bottom', 'row-dragging'));

          if (!targetRow || !dragSrcRow || targetRow === dragSrcRow) return;

          const targetIdx = parseInt(targetRow.getAttribute('data-row-idx'), 10);
          if (isNaN(dragSrcIdx) || isNaN(targetIdx) || dragSrcIdx === targetIdx) return;

          const sheet = dragSheetName;
          if (sheet === 'DATA_PASIEN') {
            const [moved] = state.patients.splice(dragSrcIdx, 1);
            state.patients.splice(targetIdx, 0, moved);
            state.patients.forEach((p, i) => { p.rowNumber = i + 2; });
            renderTablePatients();
          } else if (sheet === 'SETTING') {
            const [moved] = state.settings.splice(dragSrcIdx, 1);
            state.settings.splice(targetIdx, 0, moved);
            renderTableSettings();
          } else if (sheet === 'CUSTOM_FORMAT') {
            const [moved] = state.templates.splice(dragSrcIdx, 1);
            state.templates.splice(targetIdx, 0, moved);
            renderTableTemplates();
          } else if (sheet === 'CUSTOM_PROMPT') {
            const [moved] = state.prompts.splice(dragSrcIdx, 1);
            state.prompts.splice(targetIdx, 0, moved);
            renderTablePrompts();
          }

          showToast(`Baris dipindahkan ke posisi baris ${targetIdx + 2}`, 'info');

          // Sync with Server & Upstash Redis
          try {
            await fetch('/api', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                action: 'reorder_rows',
                sheet: sheet,
                fromIndex: dragSrcIdx,
                toIndex: targetIdx
              })
            });
          } catch (err) {
            console.error('Error reordering rows:', err);
          }
        });
      });
    }

    // Helper: Batalkan inline editor yang sedang aktif tanpa memicu commit basi
    function cancelActiveInlineEdit() {
      if (state.activeInlineEditor) {
        if (typeof state.activeInlineEditor.cancel === 'function') {
          state.activeInlineEditor.cancel();
        }
        state.activeInlineEditor = null;
      }
    }

    // =========================================================================
    // INLINE CELL DOUBLE-CLICK EDITING
    // =========================================================================
    function startInlineEdit(cellEl, colKey, rowNum, sheetName) {
      if (cellEl.querySelector('input.cell-inline-editor')) return;
      cancelActiveInlineEdit();

      const currentVal = cellEl.textContent.trim();
      const input = document.createElement('input');
      input.className = 'cell-inline-editor';
      input.value = currentVal === '-' ? '' : currentVal;
      cellEl.innerHTML = '';
      cellEl.appendChild(input);
      input.focus();
      input.select();

      let committed = false;

      function cancel() {
        committed = true;
        if (cellEl.contains(input)) {
          cellEl.textContent = currentVal;
        }
      }

      state.activeInlineEditor = { input, cancel };

      function commit(force = false) {
        if (committed) return;
        const newVal = input.value.trim() || '-';

        // Jika nilai tidak berubah dari nilai awal sel dan tidak dipaksa (force), jangan overwrite ke server!
        if (!force && newVal === currentVal) {
          committed = true;
          cellEl.textContent = currentVal;
          state.activeInlineEditor = null;
          return;
        }

        committed = true;
        state.activeInlineEditor = null;

        cellEl.textContent = newVal;
        state.selectedCell.value = newVal;
        const fInput = document.getElementById('formula-input');
        if (fInput) fInput.value = newVal;

        if (sheetName === 'DATA_PASIEN') {
          const patient = state.patients.find(p => p.rowNumber === rowNum);
          if (patient) {
            patient[colKey] = newVal;
            if (colKey === 'noHp') patient.cleanPhone = formatInternationalPhone(newVal);
          }
        }
        showToast(`Sel ${state.selectedCell.coord || colKey + rowNum} diperbarui: ${newVal}`);

        fetch('/api', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'update_cell',
            sheet: sheetName,
            row: rowNum,
            colKey: colKey,
            value: newVal
          })
        }).then(() => {
          loadAllData(false);
        }).catch(err => console.error('Inline edit sync error:', err));
      }

      input._commit = commit;

      input.addEventListener('paste', (e) => {
        const pasteVal = (e.clipboardData || window.clipboardData).getData('text/plain');
        if (pasteVal && !pasteVal.includes('\t') && !pasteVal.includes('\n')) {
          e.preventDefault();
          input.value = pasteVal.trim();
          commit(true);
        }
      });

      input.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          commit(true);
        } else if (e.key === 'Escape') {
          cancel();
        }
      });
      input.addEventListener('blur', () => {
        commit(false);
      });
    }

    // =========================================================================
    // KEYBOARD DELETE / BACKSPACE TO CLEAR CELL CONTENT
    // =========================================================================
    function clearSelectedCellContent() {
      if (!state.selectedCell || !state.selectedCell.coord) return;
      const coord = state.selectedCell.coord;
      const cellEl = document.querySelector(`.cell[data-coord="${coord}"]`);
      if (!cellEl) return;

      const colMatch = coord.match(/^([A-Z]+)(\d+)$/);
      if (!colMatch) return;
      const colLetter = colMatch[1];
      const rowNum = parseInt(colMatch[2], 10);

      // Save Undo
      saveCellUndoState(cellEl);

      // Optimistic Clear
      cellEl.textContent = "-";
      cellEl.classList.add("cell-cleared-flash");
      setTimeout(() => cellEl.classList.remove("cell-cleared-flash"), 800);

      const fInput = document.getElementById("formula-input");
      if (fInput) fInput.value = "-";
      state.selectedCell.value = "-";

      const patientColMap = {
        'A': 'timestamp', 'B': 'noRm', 'C': 'namaPasien', 'D': 'tglMasuk', 'E': 'tglKontrol',
        'F': 'noHp', 'G': 'tempatTglLahir', 'H': 'umur', 'I': 'agama', 'J': 'jenisKelamin',
        'K': 'statusWaH2', 'L': 'statusDokterH2', 'M': 'statusWaH1', 'N': 'statusDokterH1',
        'O': 'noSender', 'P': 'statusReschedule', 'Q': 'statusRujukan', 'R': 'noLid', 'S': 'tglReschedule'
      };

      const activeSheet = state.activeSheet || 'DATA_PASIEN';
      const colKey = patientColMap[colLetter] || colLetter;

      if (activeSheet === 'DATA_PASIEN') {
        const patient = state.patients.find(p => p.rowNumber === rowNum);
        if (patient && colKey) {
          patient[colKey] = "-";
          if (colKey === 'noHp') patient.cleanPhone = "-";
        }
      }

      showToast(`Isi sel ${coord} berhasil dikosongkan (Delete)`);

      fetch('/api', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          action: 'clear_cell',
          sheet: activeSheet,
          row: rowNum,
          colKey: colKey,
          value: '-'
        })
      }).catch(err => console.error('Clear cell error:', err));
    }

    // Sync with GAS
    async function syncWithGAS() {
      const btn = document.getElementById("btn-sync-pull");
      const origHtml = btn.innerHTML;
      btn.innerHTML = `<i class="fas fa-spinner fa-spin"></i> <span>Sinkronisasi...</span>`;
      btn.disabled = true;

      try {
        const res = await fetch("/api/sync/pull", { method: "POST" });
        const json = await res.json();
        if (json.status === "success") {
          showToast(json.message);
          loadAllData();
        } else {
          showToast(json.message, "error");
        }
      } catch (err) {
        showToast(`Sync error: ${err.message}`, "error");
      } finally {
        btn.innerHTML = origHtml;
        btn.disabled = false;
      }
    }

    // Export CSV
    function exportActiveSheetToCSV() {
      let csvContent = "data:text/csv;charset=utf-8,";
      let filename = `${state.activeSheet}_${new Date().toISOString().substring(0, 10)}.csv`;

      if (state.activeSheet === "DATA_PASIEN") {
        const headers = ["Timestamp", "No RM", "Nama Pasien", "Tanggal Masuk", "Tanggal Kontrol", "No WA", "Tempat Tgl Lahir", "Umur", "Agama", "Jenis Kelamin", "Status WA H-2", "Status Dokter H-2", "Status WA H-1", "Status Dokter H-1", "No Sender", "Status Reschedule", "Status Rujukan", "No LID", "Tanggal Reschedule"];
        csvContent += headers.map(h => `"${h}"`).join(",") + "\r\n";

        state.patients.forEach(p => {
          const row = [
            p.timestamp, p.noRm, p.namaPasien, p.tglMasuk, p.tglKontrol, p.cleanPhone || p.noHp,
            p.tempatTglLahir, p.umur, p.agama, p.jenisKelamin, p.statusWaH2, p.statusDokterH2,
            p.statusWaH1, p.statusDokterH1, p.noSender, p.statusReschedule, p.statusRujukan,
            p.noLid, p.tglReschedule
          ];
          csvContent += row.map(val => `"${String(val || '').replace(/"/g, '""')}"`).join(",") + "\r\n";
        });
      } else if (state.activeSheet === "SETTING") {
        csvContent += `"PARAMETER","VALUE","KETERANGAN"\r\n`;
        state.settings.forEach(s => {
          csvContent += `"${s.parameter}","${String(s.value).replace(/"/g, '""')}","${String(s.keterangan || '').replace(/"/g, '""')}"\r\n`;
        });
      } else if (state.activeSheet === "CUSTOM_FORMAT") {
        csvContent += `"KODE_TEMPLATE","TARGET_PENERIMA","TEMPLATE_PESAN","PARAMETER_TERSEDIA"\r\n`;
        state.templates.forEach(t => {
          csvContent += `"${t.kodeTemplate}","${t.targetPenerima}","${String(t.templatePesan).replace(/"/g, '""')}","${t.parameterTersedia}"\r\n`;
        });
      }

      const encodedUri = encodeURI(csvContent);
      const link = document.createElement("a");
      link.setAttribute("href", encodedUri);
      link.setAttribute("download", filename);
      document.body.appendChild(link);
      link.click();
      link.remove();
      showToast(`File CSV ${filename} berhasil diunduh!`);
    }

    // Toggle Fullscreen
    function toggleFullscreen() {
      if (!document.fullscreenElement) {
        document.documentElement.requestFullscreen().catch(() => {});
      } else {
        if (document.exitFullscreen) document.exitFullscreen().catch(() => {});
      }
    }

    // Initialize on page load
    window.addEventListener("DOMContentLoaded", () => {
      loadAllData();
    });
  </script>
</body>
</html>
