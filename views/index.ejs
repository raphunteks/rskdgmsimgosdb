    function handleCustomHChange(val) {
      const container = document.getElementById("custom-h-container");
      const clearBtn = document.getElementById("custom-h-clear-btn");
      const trimmed = String(val).trim();

      if (trimmed !== "" && !isNaN(trimmed)) {
        state.customHDays = parseInt(trimmed);
