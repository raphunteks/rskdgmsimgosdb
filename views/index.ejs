<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title><%= title %></title>
  <link rel="icon" type="image/png" href="/img/axalogo.png">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>

  <!-- 1. TOP HEADER & MENUBAR (GLASSMORPHISM) -->
  <header class="app-header">
    <div class="brand-section">
      <img src="/img/axalogo.png" alt="RSKDGM Logo" class="brand-logo">
      <div class="brand-title-group">
        <h1>
          <span>RSKDGM SIMGOS v2</span>
          <span class="brand-badge">PRO v2.4</span>
        </h1>
        <div class="brand-menu">
          <span class="menu-item" onclick="openAddModal()">File</span>
          <span class="menu-item" onclick="showToast('Undo / Redo siap digunakan')">Edit</span>
          <span class="menu-item" onclick="toggleFullscreen()">Tampilan</span>
          <span class="menu-item" onclick="openAddModal()">Sisipkan</span>
          <span class="menu-item" onclick="switchTab('DATA_PASIEN')">Data</span>
          <a href="/admin" class="menu-item" style="color: #10b981; font-weight: 700;">
            <i class="fas fa-chart-pie"></i> Admin Analytics
          </a>
          <a href="/restsheet" class="menu-item" style="color: var(--accent); font-weight: 600;">
            <i class="fas fa-terminal"></i> RestSheet Console
          </a>
        </div>
      </div>
    </div>

    <div class="header-actions">
      <!-- Theme Switcher Dropdown (Default Light) -->
      <div class="theme-selector-wrap">
        <select class="theme-dropdown-select" id="theme-select" onchange="changeTheme(this.value)" title="Ganti Tema Tampilan">
          <option value="light" selected>☀️ Terang (Default)</option>
          <option value="blue-cyan">🌊 Blue Cyan Soft</option>
          <option value="dark">🌙 Dark Glass</option>
        </select>
      </div>

      <!-- Storage Status Indicator -->
      <div class="status-indicator-group">
        <div class="status-pill redis-pill" title="Upstash Redis Layer 1 Status">
          <span class="status-dot online"></span>
          <span>Redis L1</span>
          <span class="status-latency">&lt;10ms</span>
        </div>
        <div class="status-pill gas-pill" title="Google Sheets Secondary Backup Status">
          <span class="status-dot gas"></span>
          <span>GAS L2</span>
        </div>
      </div>

      <!-- Sync Button -->
      <button class="btn btn-secondary btn-sm" id="btn-sync-pull" onclick="syncWithGAS()" title="Tarik data terbaru dari Google Spreadsheet">
        <i class="fas fa-sync-alt"></i> <span class="d-none-mobile">Tarik GAS</span>
      </button>

      <!-- Add Record Button -->
      <button class="btn btn-primary btn-sm" id="btn-add-primary" onclick="openAddModal()">
        <i class="fas fa-plus"></i> <span class="d-none-mobile">Tambah Data</span>
      </button>
    </div>
  </header>

  <!-- GOOGLE SHEETS PRECISION FORMATTING TOOLBAR (GAMBAR 1) -->
  <div class="sheets-format-toolbar" id="sheets-formatting-toolbar">
    
    <!-- 1. Search menus -->
    <div class="tb-group">
      <button class="tb-search-menu-btn" onclick="document.getElementById('global-search').focus()" title="Telusuri menu (Alt+/)">
        <i class="fas fa-search"></i>
        <span>Telusuri</span>
      </button>
    </div>

    <div class="tb-divider"></div>

    <!-- 2. History & Print -->
    <div class="tb-group">
      <button class="tb-btn" id="tb-undo" onclick="sheetFormatUndo()" title="Urungkan (Ctrl+Z)">
        <i class="fas fa-undo"></i>
      </button>
      <button class="tb-btn" id="tb-redo" onclick="sheetFormatRedo()" title="Ulangi (Ctrl+Y)">
        <i class="fas fa-redo"></i>
      </button>
      <button class="tb-btn" id="tb-print" onclick="window.print()" title="Cetak (Ctrl+P)">
        <i class="fas fa-print"></i>
      </button>
      <button class="tb-btn" id="tb-paint-format" onclick="sheetFormatPainter()" title="Format cat / Format Painter">
        <i class="fas fa-paint-roller"></i>
      </button>
    </div>

    <div class="tb-divider"></div>

    <!-- 3. Zoom Dropdown -->
    <div class="tb-group">
      <select class="tb-select tb-select-zoom" id="tb-zoom" onchange="setSheetZoom(this.value)" title="Zoom tampilan">
        <option value="50">50%</option>
        <option value="75">75%</option>
        <option value="90">90%</option>
        <option value="100" selected>100%</option>
        <option value="125">125%</option>
        <option value="150">150%</option>
        <option value="200">200%</option>
      </select>
    </div>

    <div class="tb-divider"></div>

    <!-- 4. Number & Currency Formats -->
    <div class="tb-group">
      <button class="tb-btn" onclick="applyCellFormat('currency')" title="Format sebagai mata uang (Rp / $)">
        <i class="fas fa-dollar-sign"></i>
      </button>
      <button class="tb-btn" onclick="applyCellFormat('percent')" title="Format sebagai persen (%)">
        <i class="fas fa-percent"></i>
      </button>
      <button class="tb-btn" onclick="applyCellFormat('dec-decrease')" title="Kurangi angka desimal (.0)">
        <span style="font-size: 11px; font-weight:700;">.0<i class="fas fa-arrow-left" style="font-size:8px;"></i></span>
      </button>
      <button class="tb-btn" onclick="applyCellFormat('dec-increase')" title="Tambah angka desimal (.00)">
        <span style="font-size: 11px; font-weight:700;"><i class="fas fa-arrow-right" style="font-size:8px;"></i>.00</span>
      </button>
      <button class="tb-btn" onclick="applyCellFormat('number')" title="Format angka lainnya (123)">
        <span style="font-size: 10px; font-weight:700; font-family:var(--font-mono);">123</span>
      </button>
    </div>

    <div class="tb-divider"></div>

    <!-- 5. Font Family & Size -->
    <div class="tb-group">
      <select class="tb-select tb-select-font" id="tb-font-family" onchange="applyCellFontFamily(this.value)" title="Keluarga Font">
        <option value="'Plus Jakarta Sans', sans-serif" selected>Jakarta Sans</option>
        <option value="Arial, sans-serif">Arial</option>
        <option value="'Roboto', sans-serif">Roboto</option>
        <option value="'Inter', sans-serif">Inter</option>
        <option value="'JetBrains Mono', monospace">JetBrains Mono</option>
        <option value="Georgia, serif">Georgia</option>
      </select>

      <div class="tb-font-size-stepper">
        <button class="tb-btn" onclick="stepFontSize(-1)" title="Perkecil ukuran font">
          <i class="fas fa-minus"></i>
        </button>
        <input type="text" class="tb-font-size-input" id="tb-font-size" value="12" onchange="applyCellFontSize(this.value)">
        <button class="tb-btn" onclick="stepFontSize(1)" title="Perbesar ukuran font">
          <i class="fas fa-plus"></i>
        </button>
      </div>
    </div>

    <div class="tb-divider"></div>

    <!-- 6. Bold, Italic, Strikethrough, Colors -->
    <div class="tb-group">
      <button class="tb-btn" id="tb-btn-bold" onclick="toggleCellBold()" title="Tebal / Bold (Ctrl+B)">
        <i class="fas fa-bold"></i>
      </button>
      <button class="tb-btn" id="tb-btn-italic" onclick="toggleCellItalic()" title="Miring / Italic (Ctrl+I)">
        <i class="fas fa-italic"></i>
      </button>
      <button class="tb-btn" id="tb-btn-strike" onclick="toggleCellStrike()" title="Coret / Strikethrough (Alt+Shift+5)">
        <i class="fas fa-strikethrough"></i>
      </button>
      
      <!-- Text Color Button with Color Bar -->
      <div class="tb-btn tb-color-btn" title="Warna teks">
        <span style="font-weight:800; font-size:12px; line-height:1;">A</span>
        <div class="tb-color-bar" id="tb-text-color-bar"></div>
        <input type="color" class="tb-color-input-hidden" id="tb-text-color-picker" value="#ef4444" onchange="applyCellTextColor(this.value)">
      </div>

      <!-- Fill Color Button (Bucket) with Color Bar -->
      <div class="tb-btn tb-color-btn" title="Warna isi / Fill color">
        <i class="fas fa-fill-drip" style="font-size:11px;"></i>
        <div class="tb-color-bar tb-fill-bar" id="tb-fill-color-bar"></div>
        <input type="color" class="tb-color-input-hidden" id="tb-fill-color-picker" value="#fef08a" onchange="applyCellFillColor(this.value)">
      </div>
    </div>

    <div class="tb-divider"></div>

    <!-- 7. Borders & Merge -->
    <div class="tb-group">
      <button class="tb-btn" onclick="applyCellBorder()" title="Batas / Borders">
        <i class="fas fa-border-all"></i>
      </button>
      <button class="tb-btn" onclick="applyCellMerge()" title="Gabungkan sel / Merge">
        <i class="fas fa-table-cells-large"></i>
      </button>
    </div>

    <div class="tb-divider"></div>

    <!-- 8. Alignments & Wrapping -->
    <div class="tb-group">
      <button class="tb-btn" id="tb-align-left" onclick="applyCellAlign('left')" title="Rata kiri">
        <i class="fas fa-align-left"></i>
      </button>
      <button class="tb-btn" id="tb-align-center" onclick="applyCellAlign('center')" title="Rata tengah">
        <i class="fas fa-align-center"></i>
      </button>
      <button class="tb-btn" id="tb-align-right" onclick="applyCellAlign('right')" title="Rata kanan">
        <i class="fas fa-align-right"></i>
      </button>
      <button class="tb-btn" onclick="applyCellVerticalAlign()" title="Perataan vertikal">
        <i class="fas fa-arrows-alt-v"></i>
      </button>
      <button class="tb-btn" id="tb-text-wrap" onclick="toggleCellWrap()" title="Pelipatan teks / Text Wrap">
        <i class="fas fa-text-width"></i>
      </button>
      <button class="tb-btn" onclick="applyTextRotation()" title="Rotasi teks">
        <i class="fas fa-italic" style="transform: rotate(25deg);"></i>
      </button>
    </div>

    <div class="tb-divider"></div>

    <!-- 9. Insert Link, Comment, Chart, Filter, Functions -->
    <div class="tb-group">
      <button class="tb-btn" onclick="insertLinkPrompt()" title="Sisipkan link (Ctrl+K)">
        <i class="fas fa-link"></i>
      </button>
      <button class="tb-btn" onclick="insertCommentPrompt()" title="Sisipkan komentar">
        <i class="fas fa-comment-alt"></i>
      </button>
      <button class="tb-btn" onclick="window.location.href='/admin'" title="Buka grafik analisis (Admin)">
        <i class="fas fa-chart-pie"></i>
      </button>
      <button class="tb-btn" onclick="toggleFilterBar()" title="Buat filter">
        <i class="fas fa-filter"></i>
      </button>
      <button class="tb-btn" onclick="insertFunctionPrompt()" title="Fungsi formula (SUM, AVERAGE, COUNT)">
        <span style="font-weight: 800; font-size:12px;">&Sigma;</span>
      </button>
    </div>

  </div>

  <!-- 2. FORMULA & ADDRESS BAR (DESKTOP/TABLET) -->
  <div class="formula-bar-container">
    <div class="cell-name-box" id="cell-address" title="Koordinat Sel Terpilih">A1</div>
    <div class="formula-symbol" title="Formula & Nilai Sel">fx</div>
    <div class="formula-input-wrapper">
      <input type="text" id="formula-input" placeholder="Pilih sel pada spreadsheet untuk melihat atau mengedit nilai...">
    </div>
  </div>

  <!-- 3. ACTION TOOLBAR, DUAL-VIEW TOGGLE & FILTER -->
  <div class="action-toolbar">
    <div class="toolbar-left">
      <!-- View Mode Toggle: Grid vs Mobile Cards -->
      <div class="view-mode-toggle">
        <button class="view-toggle-btn active" id="btn-view-grid" onclick="setViewMode('grid')" title="Tampilan Spreadsheet Grid">
          <i class="fas fa-table"></i> <span>Grid</span>
        </button>
        <button class="view-toggle-btn" id="btn-view-cards" onclick="setViewMode('cards')" title="Tampilan Kartu Medis Mobile">
          <i class="fas fa-id-card"></i> <span>Kartu</span>
        </button>
      </div>

      <!-- Quick Filter Pills -->
      <div class="filter-pills">
        <button class="filter-btn active" data-filter="all" onclick="applyFilter('all')">
          <i class="fas fa-list"></i> Semua
        </button>
        <button class="filter-btn" data-filter="h2" onclick="applyFilter('h2')">
          <i class="fas fa-bell"></i> H-2
        </button>
        <button class="filter-btn" data-filter="h1" onclick="applyFilter('h1')">
          <i class="fas fa-calendar-check"></i> H-1
        </button>
        <!-- Custom H- Filter Pill -->
        <div class="custom-h-pill" id="custom-h-container">
          <button class="filter-btn custom-h-btn" data-filter="custom_h" onclick="focusCustomHInput(event)">
            <i class="fas fa-calendar-alt"></i> H-
          </button>
          <input type="number" id="custom-h-input" class="custom-h-input" placeholder="0, 3..." min="0" max="365"
            title="Ketik angka selisih hari (misal 0 untuk Hari H, 3 untuk H-3, 7 untuk H-7)"
            oninput="handleCustomHChange(this.value)" onkeydown="handleCustomHKey(event)">
          <button type="button" class="custom-h-clear" id="custom-h-clear-btn" onclick="clearCustomHFilter(event)" title="Reset Filter H-">&times;</button>
        </div>
        <button class="filter-btn" data-filter="reschedule" onclick="applyFilter('reschedule')">
          <i class="fas fa-history"></i> Reschedule
        </button>
        <button class="filter-btn" data-filter="rujukan_aktif" onclick="applyFilter('rujukan_aktif')">
          <i class="fas fa-file-medical"></i> Rujukan
        </button>
        <button class="filter-btn" data-filter="unlinked" onclick="applyFilter('unlinked')">
          <i class="fas fa-link-slash"></i> Butuh LID
        </button>
      </div>
    </div>

    <div class="toolbar-right">
      <!-- Global Search -->
      <div class="search-box">
        <i class="fas fa-search search-icon"></i>
        <input type="text" id="global-search" placeholder="Cari Nama, No RM, WA, LID..." oninput="handleSearch(this.value)">
        <button id="search-clear" onclick="clearSearch()" style="display:none;"><i class="fas fa-times"></i></button>
      </div>

      <!-- Export CSV -->
      <button class="btn btn-secondary btn-sm" onclick="exportActiveSheetToCSV()" title="Ekspor data sheet aktif ke file CSV">
        <i class="fas fa-file-csv"></i> <span>CSV</span>
      </button>

      <!-- Reload -->
      <button class="btn btn-secondary btn-sm btn-icon-only" onclick="loadAllData(true)" title="Muat ulang tabel">
        <i class="fas fa-redo-alt"></i>
      </button>
    </div>
  </div>

  <!-- 4. MAIN SPREADSHEET WORKSPACE -->
  <main class="spreadsheet-workspace" id="spreadsheet-container">
    
    <!-- SHEET 1: DATA_PASIEN (19 Columns A to S) -->
    <div class="sheet-view-wrapper active" id="view-DATA_PASIEN">
      
      <!-- View Option A: Classic Google Sheets Table Grid -->
      <div class="grid-table-container" id="grid-container-DATA_PASIEN">
        <table class="spreadsheet-table" id="table-DATA_PASIEN">
          <thead>
            <tr>
              <th class="col-row-number">#</th>
              <th class="col-header" data-col="A" onclick="selectColumn(this, 'A', 1)" title="Klik untuk memblok/memilih Kolom A">A<span class="sub-col">Timestamp</span></th>
              <th class="col-header" data-col="B" onclick="selectColumn(this, 'B', 2)" title="Klik untuk memblok/memilih Kolom B">B<span class="sub-col">No RM</span></th>
              <th class="col-header" data-col="C" onclick="selectColumn(this, 'C', 3)" title="Klik untuk memblok/memilih Kolom C">C<span class="sub-col">Nama Pasien</span></th>
              <th class="col-header" data-col="D" onclick="selectColumn(this, 'D', 4)" title="Klik untuk memblok/memilih Kolom D">D<span class="sub-col">Tanggal Masuk</span></th>
              <th class="col-header" data-col="E" onclick="selectColumn(this, 'E', 5)" title="Klik untuk memblok/memilih Kolom E">E<span class="sub-col">Tanggal Kontrol</span></th>
              <th class="col-header" data-col="F" onclick="selectColumn(this, 'F', 6)" title="Klik untuk memblok/memilih Kolom F">F<span class="sub-col">No WA</span></th>
              <th class="col-header" data-col="G" onclick="selectColumn(this, 'G', 7)" title="Klik untuk memblok/memilih Kolom G">G<span class="sub-col">Tempat / Tgl Lahir</span></th>
              <th class="col-header" data-col="H" onclick="selectColumn(this, 'H', 8)" title="Klik untuk memblok/memilih Kolom H">H<span class="sub-col">Umur</span></th>
              <th class="col-header" data-col="I" onclick="selectColumn(this, 'I', 9)" title="Klik untuk memblok/memilih Kolom I">I<span class="sub-col">Agama</span></th>
              <th class="col-header" data-col="J" onclick="selectColumn(this, 'J', 10)" title="Klik untuk memblok/memilih Kolom J">J<span class="sub-col">Jenis Kelamin</span></th>
              <th class="col-header" data-col="K" onclick="selectColumn(this, 'K', 11)" title="Klik untuk memblok/memilih Kolom K">K<span class="sub-col">Status Kirim WA H-2</span></th>
              <th class="col-header" data-col="L" onclick="selectColumn(this, 'L', 12)" title="Klik untuk memblok/memilih Kolom L">L<span class="sub-col">Status Notif Dokter H-2</span></th>
              <th class="col-header" data-col="M" onclick="selectColumn(this, 'M', 13)" title="Klik untuk memblok/memilih Kolom M">M<span class="sub-col">Status Kirim WA H-1</span></th>
              <th class="col-header" data-col="N" onclick="selectColumn(this, 'N', 14)" title="Klik untuk memblok/memilih Kolom N">N<span class="sub-col">Status Notif Dokter H-1</span></th>
              <th class="col-header" data-col="O" onclick="selectColumn(this, 'O', 15)" title="Klik untuk memblok/memilih Kolom O">O<span class="sub-col">No Sender</span></th>
              <th class="col-header" data-col="P" onclick="selectColumn(this, 'P', 16)" title="Klik untuk memblok/memilih Kolom P">P<span class="sub-col">Status Reschedule</span></th>
              <th class="col-header" data-col="Q" onclick="selectColumn(this, 'Q', 17)" title="Klik untuk memblok/memilih Kolom Q">Q<span class="sub-col">Status Rujukan</span></th>
              <th class="col-header" data-col="R" onclick="selectColumn(this, 'R', 18)" title="Klik untuk memblok/memilih Kolom R">R<span class="sub-col">No LID</span></th>
              <th class="col-header" data-col="S" onclick="selectColumn(this, 'S', 19)" title="Klik untuk memblok/memilih Kolom S">S<span class="sub-col">Tanggal Reschedule</span></th>
              <th class="col-action-header">Aksi</th>
            </tr>
          </thead>
          <tbody id="tbody-DATA_PASIEN">
            <!-- Populated dynamically via JS -->
            <tr>
              <td colspan="21" class="loading-state" style="text-align: center; padding: 30px; color: var(--text-dim);">
                <i class="fas fa-spinner fa-spin"></i> Memuat database rekam medis SIMGOS dari Redis...
              </td>
            </tr>
          </tbody>
        </table>

        <!-- Append Rows Bar (Google Sheets Style: Tambah baris tanpa batas) -->
        <div class="sheet-append-rows-bar">
          <button class="btn btn-secondary btn-sm" onclick="appendRowsAction(100)">
            <i class="fas fa-plus"></i> Tambah 100 Baris
          </button>
          <span>atau tambahkan</span>
          <input type="number" class="sheet-append-rows-input" id="append-rows-count-DATA_PASIEN" value="1000" min="1" max="1000">
          <span>baris lagi</span>
          <button class="btn btn-primary btn-sm" onclick="appendRowsCustom('DATA_PASIEN')">
            <i class="fas fa-layer-group"></i> Tambah Baris
          </button>
          <span style="margin-left: auto; font-size: 11px; color: var(--text-dim);">
            <i class="fas fa-info-circle"></i> Tips: Anda dapat langsung <strong>Cmd+V / Ctrl+V</strong> untuk paste data dari Google Sheets / Excel kapan saja!
          </span>
        </div>
      </div>

      <!-- View Option B: Glassmorphic Medical Cards View (Mobile & Tablet Friendly) -->
      <div class="mobile-cards-container" id="cards-container-DATA_PASIEN">
        <div class="patient-cards-grid" id="cards-grid-DATA_PASIEN">
          <!-- Populated dynamically via renderCardsPatients() -->
        </div>
      </div>

    </div>

    <!-- SHEET 2: SETTING -->
    <div class="sheet-view-wrapper" id="view-SETTING">
      <div class="grid-table-container">
        <table class="spreadsheet-table" id="table-SETTING">
          <thead>
            <tr>
              <th class="col-row-number">#</th>
              <th class="col-header" data-col="A" style="width: 250px;" onclick="selectColumn(this, 'A', 1)" title="Klik untuk memblok Kolom A">A<span class="sub-col">PARAMETER</span></th>
              <th class="col-header" data-col="B" style="width: 320px;" onclick="selectColumn(this, 'B', 2)" title="Klik untuk memblok Kolom B">B<span class="sub-col">VALUE</span></th>
              <th class="col-header" data-col="C" onclick="selectColumn(this, 'C', 3)" title="Klik untuk memblok Kolom C">C<span class="sub-col">KETERANGAN</span></th>
              <th class="col-action-header">Aksi</th>
            </tr>
          </thead>
          <tbody id="tbody-SETTING">
            <!-- Populated dynamically -->
          </tbody>
        </table>

        <div class="sheet-append-rows-bar">
          <button class="btn btn-secondary btn-sm" onclick="appendRowsAction(10)">
            <i class="fas fa-plus"></i> Tambah 10 Baris
          </button>
          <span>atau tambahkan</span>
          <input type="number" class="sheet-append-rows-input" id="append-rows-count-SETTING" value="50" min="1" max="500">
          <span>baris</span>
          <button class="btn btn-primary btn-sm" onclick="appendRowsCustom('SETTING')">
            <i class="fas fa-layer-group"></i> Tambah
          </button>
          <span style="margin-left: auto; font-size: 11px; color: var(--text-dim);">
            <i class="fas fa-info-circle"></i> Tips: Tekan <strong>Cmd+V / Ctrl+V</strong> untuk paste pengaturan secara instan.
          </span>
        </div>
      </div>
    </div>

    <!-- SHEET 3: CUSTOM_FORMAT -->
    <div class="sheet-view-wrapper" id="view-CUSTOM_FORMAT">
      <div class="grid-table-container">
        <table class="spreadsheet-table" id="table-CUSTOM_FORMAT">
          <thead>
            <tr>
              <th class="col-row-number">#</th>
              <th class="col-header" data-col="A" style="width: 220px;" onclick="selectColumn(this, 'A', 1)" title="Klik untuk memblok Kolom A">A<span class="sub-col">KODE_TEMPLATE</span></th>
              <th class="col-header" data-col="B" style="width: 240px;" onclick="selectColumn(this, 'B', 2)" title="Klik untuk memblok Kolom B">B<span class="sub-col">TARGET_PENERIMA</span></th>
              <th class="col-header" data-col="C" style="width: 480px;" onclick="selectColumn(this, 'C', 3)" title="Klik untuk memblok Kolom C">C<span class="sub-col">TEMPLATE_PESAN</span></th>
              <th class="col-header" data-col="D" style="width: 200px;" onclick="selectColumn(this, 'D', 4)" title="Klik untuk memblok Kolom D">D<span class="sub-col">PARAMETER_TERSEDIA</span></th>
              <th class="col-action-header">Aksi</th>
            </tr>
          </thead>
          <tbody id="tbody-CUSTOM_FORMAT">
            <!-- Populated dynamically -->
          </tbody>
