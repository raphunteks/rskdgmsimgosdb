    function applyCellFormat(type) {
      const cell = getActiveOrHoverCell();
      if (!cell) return;
      saveCellUndoState(cell);
      let text = cell.textContent.trim();
      let num = parseFloat(text.replace(/[^0-9.-]+/g, ""));
      if (isNaN(num)) num = 1000;

      if (type === 'currency') {
        cell.textContent = new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(num);
      } else if (type === 'percent') {
        cell.textContent = (num / 100).toLocaleString('id-ID', { style: 'percent', minimumFractionDigits: 1 });
      } else if (type === 'dec-decrease') {
        cell.textContent = Math.round(num);
      } else if (type === 'dec-increase') {
        cell.textContent = num.toFixed(2);
      } else if (type === 'number') {
        cell.textContent = num.toLocaleString('id-ID');
      }
      showToast(`Format ${type} diterapkan`);
    }

