    function quickReschedulePrompt(noRm, nama) {
      const newDate = prompt(`Jadwalkan ulang pasien ${nama} (RM: ${noRm}):\nMasukkan tanggal baru (Format: YYYY-MM-DD):`, new Date().toISOString().substring(0, 10));
      if (newDate && /^\d{4}-\d{2}-\d{2}$/.test(newDate)) {
        fetch(`/api?action=reschedule_patient&noRm=${encodeURIComponent(noRm)}&newDate=${newDate}`)
          .then(r => r.json())
          .then(res => {
            if (res.status === "success") {
              showToast(res.message);
              loadAllData();
            } else {
              showToast(res.message, "error");
            }
          })
          .catch(e => showToast(e.message, "error"));
      }
    }

    function getBadgeClass(status) {
      if (!status || status === "-" || status === "Pending") return "badge-muted";
      if (status.toLowerCase().includes("terkirim") || status.toLowerCase().includes("hadir")) return "badge-success";
      if (status.toLowerCase().includes("reschedule")) return "badge-warning";
      if (status.toLowerCase().includes("gagal") || status.toLowerCase().includes("terbatalkan")) return "badge-danger";
      return "badge-info";
    }

