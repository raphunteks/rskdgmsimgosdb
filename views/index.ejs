  <!-- CLIENT-SIDE LOGIC -->
  <script>
    // State Store
    let state = {
      activeSheet: "DATA_PASIEN",
      viewMode: "grid", // "grid" or "cards"
      patients: [],
      settings: [],
      templates: [],
      prompts: [],
      activeFilter: "all",
      customHDays: null,
      isAllSelected: false,
      selectedColumn: null,
      selectionRange: null,
      isSelectingRange: false,
      rangeAnchorCell: null,
      activeInlineEditor: null,
      searchQuery: "",
      selectedCell: { coord: "A1", row: 1, col: "A", value: "" },
      lastSync: null
    };

    // Auto-detect Mobile on load
    if (window.innerWidth <= 768) {
      state.viewMode = "cards";
    }

    // Live Clock
    function updateClock() {
      const now = new Date();
      const str = now.toLocaleTimeString("id-ID", { hour: "2-digit", minute: "2-digit", second: "2-digit" }) + " WITA";
      const el = document.getElementById("live-clock");
      if (el) el.textContent = str;
    }
    setInterval(updateClock, 1000);
    updateClock();

    // Toast Notification
    function showToast(msg, type = "success") {
      const container = document.getElementById("toast-container");
      const toast = document.createElement("div");
      toast.className = `toast toast-${type}`;
      const icon = type === "success" ? "fa-check-circle" : (type === "error" ? "fa-exclamation-triangle" : "fa-info-circle");
      toast.innerHTML = `<i class="fas ${icon}"></i> <span>${msg}</span>`;
      container.appendChild(toast);
      setTimeout(() => {
        toast.style.opacity = "0";
        toast.style.transform = "translateY(-10px)";
        setTimeout(() => toast.remove(), 300);
      }, 3500);
    }

    // Modal Helpers
    function openModal(id) {
      const el = document.getElementById(id);
      if (el) el.classList.add("active");
    }
    function closeModal(id) {
      const el = document.getElementById(id);
      if (el) el.classList.remove("active");
    }

    // View Mode Switcher: Grid vs Cards
    function setViewMode(mode) {
      state.viewMode = mode;
      document.getElementById("btn-view-grid").classList.toggle("active", mode === "grid");
      document.getElementById("btn-view-cards").classList.toggle("active", mode === "cards");

      const gridContainer = document.getElementById("grid-container-DATA_PASIEN");
      const cardsContainer = document.getElementById("cards-container-DATA_PASIEN");

      if (mode === "grid") {
        gridContainer.style.display = "block";
        cardsContainer.style.display = "none";
      } else {
        gridContainer.style.display = "none";
        cardsContainer.style.display = "block";
        renderCardsPatients();
      }
    }

    // Open Add Modal according to active sheet
    function openAddModal() {
      if (state.activeSheet === "DATA_PASIEN") {
        document.getElementById("modal-patient-title").innerHTML = `<i class="fas fa-user-plus"></i> Tambah Pasien Baru SIMGOS`;
        document.getElementById("form-patient").reset();
        document.getElementById("p-row-number").value = "";
        document.getElementById("p-tgl-masuk").value = new Date().toISOString().substring(0, 10);
        openModal("modal-patient");
      } else if (state.activeSheet === "SETTING") {
        showToast("Klik tombol Edit pada baris setting yang ingin diubah", "info");
      } else if (state.activeSheet === "CUSTOM_FORMAT") {
        showToast("Pilih salah satu template pesan untuk diedit", "info");
      } else if (state.activeSheet === "CUSTOM_PROMPT") {
        showToast("Pilih system prompt untuk dimodifikasi", "info");
      }
    }

    // Tab Switching
    function switchTab(sheetName) {
      state.activeSheet = sheetName;
      document.querySelectorAll(".sheet-tab").forEach(tab => {
        tab.classList.toggle("active", tab.dataset.sheet === sheetName);
      });
      document.querySelectorAll(".mobile-nav-item").forEach(item => {
        item.classList.toggle("active", item.dataset.sheet === sheetName);
      });
      document.querySelectorAll(".sheet-view-wrapper").forEach(view => {
        view.classList.toggle("active", view.id === `view-${sheetName}`);
      });
      updateRowCountStatus();
    }

    // Fetch All Data from Server
    async function loadAllData(showNotification = false) {
      cancelActiveInlineEdit();
      try {
        const res = await fetch("/api/data");
        const json = await res.json();
        if (json.status === "success") {
          state.patients = json.data.patients || [];
          state.settings = json.data.settings || [];
          state.templates = json.data.templates || [];
          state.prompts = json.data.prompts || [];
          state.lastSync = json.data.lastSync;

          // Update Badges
          document.getElementById("badge-patients-count").textContent = state.patients.length;
          document.getElementById("badge-settings-count").textContent = state.settings.length;
          document.getElementById("badge-templates-count").textContent = state.templates.length;
          document.getElementById("badge-prompts-count").textContent = state.prompts.length;

          renderTablePatients();
          renderCardsPatients();
          renderTableSettings();
          renderTableTemplates();
          renderTablePrompts();
          updateRowCountStatus();
          initRowDragAndDrop();

          if (showNotification) showToast(`Data berhasil dimuat (${state.patients.length} pasien)`);
        }
      } catch (err) {
        showToast(`Gagal memuat data: ${err.message}`, "error");
      }
    }

    function getDateAfterDays(days) {
      const d = new Date();
      d.setDate(d.getDate() + Number(days));
      const y = d.getFullYear();
      const m = String(d.getMonth() + 1).padStart(2, "0");
      const day = String(d.getDate()).padStart(2, "0");
      return `${y}-${m}-${day}`;
    }

    function getFilteredPatients() {
      let filtered = [...state.patients];

      // Quick Filters
      if (state.activeFilter === "h2") {
        const h2Date = getDateAfterDays(2);
        filtered = filtered.filter(p => p.tglKontrol === h2Date || p.tglReschedule === h2Date);
      } else if (state.activeFilter === "h1") {
        const h1Date = getDateAfterDays(1);
        filtered = filtered.filter(p => p.tglKontrol === h1Date || p.tglReschedule === h1Date);
      } else if (state.activeFilter === "custom_h") {
        if (state.customHDays !== null && state.customHDays !== undefined && state.customHDays !== "") {
          const targetDate = getDateAfterDays(state.customHDays);
          filtered = filtered.filter(p => p.tglKontrol === targetDate || p.tglReschedule === targetDate);
        }
      } else if (state.activeFilter === "reschedule") {
        filtered = filtered.filter(p => (p.statusReschedule && p.statusReschedule !== "-") || (p.tglReschedule && p.tglReschedule !== "-"));
      } else if (state.activeFilter === "rujukan_aktif") {
        filtered = filtered.filter(p => p.statusRujukan && p.statusRujukan.toLowerCase().includes("aktif"));
      } else if (state.activeFilter === "unlinked") {
        filtered = filtered.filter(p => !p.noLid || p.noLid === "-" || p.noLid.length < 13);
      }

      // Search Query Filter
      if (state.searchQuery) {
        const q = state.searchQuery.toLowerCase();
        filtered = filtered.filter(p => 
          (p.namaPasien && p.namaPasien.toLowerCase().includes(q)) ||
          (p.noRm && p.noRm.toLowerCase().includes(q)) ||
          (p.cleanPhone && p.cleanPhone.includes(q)) ||
          (p.noLid && p.noLid.includes(q)) ||
          (p.tglKontrol && p.tglKontrol.includes(q))
        );
      }

      return filtered;
    }

