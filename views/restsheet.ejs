<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title><%= title %></title>
  <link rel="icon" type="image/png" href="/img/axalogo.png">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>

  <!-- TOP BAR (GLASSMORPHISM) -->
  <header class="app-header">
    <div class="brand-section">
      <img src="/img/axalogo.png" alt="RSKDGM Logo" class="brand-logo">
      <div class="brand-title-group">
        <h1>
          <span>RestSheet API Hub</span>
          <span class="brand-badge">v2.4 Ultra-Fast</span>
        </h1>
        <div class="brand-menu">
          <a href="/" class="menu-item" style="color: var(--accent); font-weight: 600;">
            <i class="fas fa-table"></i> &larr; Spreadsheet Portal
          </a>
          <a href="/admin" class="menu-item" style="color: var(--primary); font-weight: 600;">
            <i class="fas fa-chart-pie"></i> Dashboard Analytics
          </a>
        </div>
      </div>
    </div>

    <div class="header-actions">
      <button class="btn btn-secondary btn-sm btn-toggle-endpoints" onclick="toggleSidebar()">
        <i class="fas fa-list"></i> Endpoints
      </button>

      <!-- Theme Switcher (Light / Blue Cyan / Dark) -->
      <div class="theme-selector-wrap">
        <select class="theme-dropdown-select" id="theme-select" onchange="changeTheme(this.value)">
          <option value="light">☀️ Terang (Default)</option>
          <option value="blue-cyan">🌊 Blue Cyan Soft</option>
          <option value="dark">🌙 Dark Glass</option>
        </select>
      </div>

      <div class="status-indicator-group">
        <div class="status-pill redis-pill">
          <span class="status-dot online"></span>
          <span>Redis L1</span>
          <span class="status-latency">&lt;1ms</span>
        </div>
      </div>
      <button class="btn btn-secondary btn-sm" onclick="copyBaseUrl()">
        <i class="fas fa-copy"></i> <span class="d-none-mobile">Salin Base URL</span>
      </button>
    </div>
  </header>

  <!-- MAIN RESTSHEET LAYOUT -->
  <div class="restsheet-layout">
    
    <!-- SIDEBAR LIST OF ENDPOINTS -->
    <aside class="api-sidebar" id="api-sidebar">
      <div class="api-sidebar-header">
        <span>DAFTAR ENDPOINT REST API</span>
        <button class="modal-close btn-toggle-endpoints" onclick="toggleSidebar()">&times;</button>
      </div>
      <div class="api-endpoints-nav">
        
        <div class="endpoint-group-title">Sistem & Diagnostik</div>
        <div class="endpoint-item active" onclick="selectEndpoint('ping')">
          <span class="method-badge method-get">GET</span>
          <span>?action=ping</span>
        </div>
        <div class="endpoint-item" onclick="selectEndpoint('health')">
          <span class="method-badge method-get">GET</span>
          <span>/api/health (Health Check)</span>
        </div>
        <div class="endpoint-item" onclick="selectEndpoint('get_settings')">
          <span class="method-badge method-get">GET</span>
          <span>?action=get_settings</span>
        </div>
        <div class="endpoint-item" onclick="selectEndpoint('get_templates')">
          <span class="method-badge method-get">GET</span>
          <span>?action=get_templates</span>
        </div>
        <div class="endpoint-item" onclick="selectEndpoint('get_active_prompt')">
          <span class="method-badge method-get">GET</span>
          <span>?action=get_active_prompt</span>
        </div>
        <div class="endpoint-item" onclick="selectEndpoint('update_setting')">
          <span class="method-badge method-get">GET</span>
          <span>?action=update_setting</span>
        </div>
        <div class="endpoint-item" onclick="selectEndpoint('update_template')">
          <span class="method-badge method-get">GET</span>
          <span>?action=update_template</span>
        </div>
        <div class="endpoint-item" onclick="selectEndpoint('fix_sender_columns')">
          <span class="method-badge method-get">GET</span>
          <span>?action=fix_sender_columns</span>
        </div>

        <div class="endpoint-group-title">Ekstensi SIMGOS & Pasien</div>
        <div class="endpoint-item" onclick="selectEndpoint('get_today_patients')">
          <span class="method-badge method-get">GET</span>
          <span>?action=get_today_patients</span>
        </div>
        <div class="endpoint-item" onclick="selectEndpoint('get_all_patient_phones')">
          <span class="method-badge method-get">GET</span>
          <span>?action=get_all_patient_phones</span>
        </div>
        <div class="endpoint-item" onclick="selectEndpoint('get_unlinked_patients')">
          <span class="method-badge method-get">GET</span>
          <span>?action=get_unlinked_patients</span>
        </div>
        <div class="endpoint-item" onclick="selectEndpoint('add_patients')">
          <span class="method-badge method-post">POST</span>
          <span>add_patients (Scraper SIMGOS)</span>
        </div>
        <div class="endpoint-item" onclick="selectEndpoint('batch_update_lids')">
          <span class="method-badge method-post">POST</span>
          <span>batch_update_lids</span>
        </div>
        <div class="endpoint-item" onclick="selectEndpoint('batch_paste')">
          <span class="method-badge method-post">POST</span>
          <span>batch_paste (Sheet Matrix)</span>
        </div>

        <div class="endpoint-group-title">WhatsApp Bot Follow-Up Blast</div>
        <div class="endpoint-item" onclick="selectEndpoint('get_followup')">
          <span class="method-badge method-get">GET</span>
          <span>?action=get_followup</span>
        </div>
        <div class="endpoint-item" onclick="selectEndpoint('search_patient')">
          <span class="method-badge method-get">GET</span>
          <span>?action=search_patient</span>
        </div>
        <div class="endpoint-item" onclick="selectEndpoint('reschedule_patient')">
          <span class="method-badge method-get">GET</span>
          <span>?action=reschedule_patient</span>
        </div>
        <div class="endpoint-item" onclick="selectEndpoint('update_status')">
          <span class="method-badge method-get">GET</span>
          <span>?action=update_status</span>
        </div>
        <div class="endpoint-item" onclick="selectEndpoint('get_summary_stats')">
          <span class="method-badge method-get">GET</span>
          <span>?action=get_summary_stats</span>
        </div>

      </div>
    </aside>

    <!-- MAIN REQUEST / RESPONSE CONSOLE -->
    <main class="api-main-content">
      
      <!-- ENDPOINT DETAILS CARD -->
      <div class="endpoint-card">
        <div class="endpoint-card-header">
          <div class="endpoint-path-box">
            <span class="method-badge method-get" id="ep-method">GET</span>
            <span id="ep-url-display">/api?action=ping</span>
          </div>
          <button class="btn btn-primary" id="btn-send-request" onclick="executeCurrentRequest()">
            <i class="fas fa-paper-plane"></i> Kirim Request
          </button>
        </div>

        <p id="ep-description" style="color: var(--text-muted); font-size: 13px; line-height: 1.5; margin-bottom: 16px;">
          Ping status server web portal, konektivitas Redis Layer 1, dan status sinkronisasi Google Sheets.
        </p>

        <!-- PARAMETERS SECTION -->
        <h4 style="font-size: 12px; text-transform: uppercase; color: var(--accent); margin-bottom: 8px;">Query Parameters</h4>
        <div id="ep-params-container">
          <!-- Dynamic parameter inputs -->
        </div>

        <!-- POST BODY SECTION (HIDDEN FOR GET) -->
        <div id="ep-post-body-container" style="display: none; margin-top: 16px;">
          <h4 style="font-size: 12px; text-transform: uppercase; color: var(--accent); margin-bottom: 8px;">Request Body (JSON)</h4>
          <textarea id="ep-post-body" class="params-input" rows="6" style="font-family: var(--font-mono);"></textarea>
        </div>
      </div>

      <!-- RESPONSE CARD -->
      <div class="response-pane">
        <div class="response-header">
          <div>
            <span style="font-weight: 700; color: var(--text-main);">RESPON SERVER:</span>
            <span id="res-status-badge" class="badge badge-success" style="margin-left: 8px;">200 OK</span>
            <span id="res-time" style="color: var(--accent); margin-left: 8px; font-family: var(--font-mono);"><i class="fas fa-bolt"></i> &lt;1ms</span>
          </div>
          <button class="btn btn-secondary btn-sm" onclick="copyResponseJson()">
            <i class="fas fa-copy"></i> Salin JSON
          </button>
        </div>
        <pre class="json-viewer" id="res-json-output">// Tekan "Kirim Request" untuk menguji endpoint secara langsung...</pre>
      </div>

      <!-- INTEGRATION SNIPPETS -->
      <div class="endpoint-card">
        <h4 style="font-size: 13px; font-weight: 600; color: var(--text-main); margin-bottom: 8px;">
          <i class="fas fa-code"></i> Potongan Kode Integrasi (WhatsApp Bot / Extension)
        </h4>
        <div class="code-snippet-box" id="ep-code-snippet">
// Contoh pemanggilan dari messageHandlerV8(RSKDGM).js:
const res = await fetch("/api?action=ping").then(r => r.json());
console.log(res);
        </div>
      </div>

    </main>
  </div>

  <div class="toast-container" id="toast-container"></div>

  <script>
    // Endpoints Catalog definition
    const ENDPOINTS = {
      ping: {
        method: "GET",
        url: "/api?action=ping",
        desc: "Mengecek status kesehatan server portal, konektivitas Upstash Redis Layer 1, dan status sinkronisasi.",
        params: [{ name: "action", default: "ping", desc: "Aksi ping" }]
      },
      health: {
        method: "GET",
        url: "/api/health",
        desc: "Endpoint diagnostik real-time untuk memonitor uptime, latensi RTT Redis (ms), dan jumlah pasien terindeks.",
        params: []
      },
      get_settings: {
        method: "GET",
        url: "/api?action=get_settings",
        desc: "Mengambil konfigurasi sistem lengkap (API Keys Gemini/Groq, dokter DPJP, delay chat, h_days, dan template pesan) identik dengan doGet GAS.",
        params: [{ name: "action", default: "get_settings", desc: "Aksi get_settings" }]
      },
      get_templates: {
        method: "GET",
        url: "/api?action=get_templates",
        desc: "Mengambil daftar seluruh template pesan WhatsApp aktif (WA_PX_H2, WA_PX_H1, WA_LAPORAN_DOKTER_H2, dll.).",
        params: [{ name: "action", default: "get_templates", desc: "Aksi get_templates" }]
      },
      get_active_prompt: {
        method: "GET",
        url: "/api?action=get_active_prompt",
        desc: "Mengambil system prompt AI RSKDGM aktif yang berregister birokratis formal serta pakar kedokteran gigi.",
        params: [{ name: "action", default: "get_active_prompt", desc: "Aksi get_active_prompt" }]
      },
      update_setting: {
        method: "GET",
        url: "/api?action=update_setting",
        desc: "Mengupdate parameter setting (contoh: DELAY_CHAT, H_HARI_FOLLOWUP, atau API Key) langsung ke database.",
        params: [
          { name: "action", default: "update_setting", desc: "Aksi update_setting" },
          { name: "param", default: "DELAY_CHAT", desc: "Nama parameter setting" },
          { name: "value", default: "60", desc: "Nilai parameter baru" }
        ]
      },
      update_template: {
        method: "GET",
        url: "/api?action=update_template",
        desc: "Mengupdate teks template pesan WhatsApp secara dinamis.",
        params: [
          { name: "action", default: "update_template", desc: "Aksi update_template" },
          { name: "code", default: "WA_PX_H2", desc: "Kode template pesan" },
          { name: "text", default: "Halo {NAMA_PASIEN}, jadwal kontrol Anda: {TGL_KONTROL}", desc: "Isi template pesan baru" }
        ]
      },
      get_today_patients: {
        method: "GET",
        url: "/api?action=get_today_patients",
        desc: "Digunakan ekstensi Chrome SIMGOS untuk pre-check pasien yang sudah terdaftar hari ini guna menghindari scraping duplikat.",
        params: [{ name: "action", default: "get_today_patients", desc: "Aksi get_today_patients" }]
      },
      get_all_patient_phones: {
        method: "GET",
        url: "/api?action=get_all_patient_phones",
        desc: "Mengambil seluruh data pasien aktif beserta no HP, nomor LID WhatsApp, dan status rujukan untuk sinkronisasi bot.",
        params: [{ name: "action", default: "get_all_patient_phones", desc: "Aksi get_all_patient_phones" }]
      },
      get_unlinked_patients: {
        method: "GET",
        url: "/api?action=get_unlinked_patients",
        desc: "Mengambil pasien yang belum memiliki Nomor LID (Kolom 18 / R masih kosong atau belum link).",
        params: [{ name: "action", default: "get_unlinked_patients", desc: "Aksi get_unlinked_patients" }]
      },
      batch_update_lids: {
        method: "POST",
        url: "/api",
        desc: "Memperbarui nomor LID dan No Sender secara massal hasil tangkapan bot WhatsApp Baileys.",
        body: JSON.stringify({
          action: "batch_update_lids",
          updates: [
            { rowNumber: 2, noRm: "00.06.32.89", noLid: "110621815218280", senderPhone: "6285394683522" }
          ]
        }, null, 2)
      },
      get_followup: {
        method: "GET",
        url: "/api?action=get_followup",
        desc: "Mengambil daftar pasien blast follow-up otomatis kontrol gigi H-2 atau H-1 dengan delay chat dan kontak DPJP.",
        params: [
          { name: "action", default: "get_followup", desc: "Aksi get_followup" },
          { name: "mode", default: "h2", desc: "Mode followup (h2 atau h1)" },
          { name: "tgl", default: "auto", desc: "Tanggal target kontrol (auto atau YYYY-MM-DD)" },
          { name: "preview", default: "false", desc: "Preview data meski sudah terkirim (true/false)" }
        ]
      },
      search_patient: {
        method: "GET",
        url: "/api?action=search_patient",
        desc: "Mencari data pasien terverifikasi secara instan (<0.1ms) via In-Memory Hash Index berdasarkan RM, Nama, WA, atau LID.",
        params: [
          { name: "action", default: "search_patient", desc: "Aksi search_patient" },
          { name: "query", default: "ILDHAYANI", desc: "Nama atau No RM pasien" },
          { name: "phone", default: "", desc: "No HP Pasien (Opsional)" },
          { name: "lid", default: "", desc: "No LID WhatsApp (Opsional)" }
        ]
      },
      reschedule_patient: {
        method: "GET",
        url: "/api?action=reschedule_patient",
        desc: "Menjadwalkan ulang kontrol pasien ke tanggal reschedule baru di Kolom 19 (S) dan status reschedule di Kolom 16 (P).",
        params: [
          { name: "action", default: "reschedule_patient", desc: "Aksi reschedule_patient" },
          { name: "noRm", default: "00.06.32.89", desc: "Nomor RM Pasien" },
          { name: "newDate", default: "2026-10-05", desc: "Tanggal kontrol baru (YYYY-MM-DD)" },
          { name: "no_lid", default: "", desc: "Nomor LID WhatsApp (Opsional)" }
        ]
      },
      update_status: {
        method: "GET",
        url: "/api?action=update_status",
        desc: "Mencatat status pengiriman blast WA pasien atau dokter secara real-time. Mendukung mode (h1/h2) dan type (pasien, dokter, both, lid_only, reschedule).",
        params: [
          { name: "action", default: "update_status", desc: "Aksi update_status" },
          { name: "row", default: "2", desc: "Nomor Baris Pasien di Database (Opsional jika kirim noRm/phone)" },
          { name: "noRm", default: "", desc: "Nomor RM Pasien (Opsional jika ada row)" },
          { name: "mode", default: "h2", desc: "Mode kontrol (h2 atau h1)" },
          { name: "type", default: "both", desc: "Target status (both, pasien, dokter, lid_only, reschedule)" },
          { name: "status", default: "Terkirim", desc: "Nilai status pengiriman WA pasien" },
          { name: "doctor_status", default: "Terkirim", desc: "Nilai status pengiriman dokter (jika type=both)" },
          { name: "no_lid", default: "", desc: "No LID WhatsApp untuk auto-bind Kolom 18 (Opsional)" }
        ]
      },
      fix_sender_columns: {
        method: "GET",
        url: "/api?action=fix_sender_columns",
        desc: "Standarisasi Kolom 15 (No Sender) menjadi No WA Asli format internasional (628xxx) dari Kolom 6 jika berisi LID atau belum valid.",
        params: [{ name: "action", default: "fix_sender_columns", desc: "Aksi standarisasi kolom sender" }]
      },
      add_patients: {
        method: "POST",
        url: "/api",
        desc: "Menerima data pasien baru hasil scraping tabel SIMGOS v2 (19 Kolom Lengkap) dari Ekstensi Chrome dengan proteksi anti-duplikasi hari ini (WITA).",
        body: JSON.stringify({
          action: "add_patients",
          patients: [
            {
              namaPasien: "PASIEN UJI COBA SIMGOS",
              noRm: "00.12.34.56",
              tglMasuk: "2026-09-15",
              tglKontrol: "2026-09-17",
              noHp: "081234567890",
              tempatTglLahir: "Makassar, 10-05-1992",
              umur: "34",
              agama: "Islam",
              jenisKelamin: "P",
              statusRujukan: "Rujukan Aktif"
            }
          ]
        }, null, 2)
      },
      batch_paste: {
        method: "POST",
        url: "/api",
        desc: "Menempelkan (paste) data matrix baris dan kolom secara langsung ke database portal (DATA_PASIEN, SETTING, CUSTOM_FORMAT, atau CUSTOM_PROMPT).",
        body: JSON.stringify({
          action: "batch_paste",
          sheet: "DATA_PASIEN",
          startRow: 2,
          startCol: 1,
          matrix: [
            ["2026-09-15 10:00:00", "00.99.88.77", "PASIEN PASTE CONTOH", "2026-09-15", "2026-09-20", "6281122334455", "Makassar", "30", "Islam", "L", "Pending", "Pending", "Pending", "Pending", "6281122334455", "-", "Rujukan Aktif", "-", "-"]
          ]
        }, null, 2)
      },
      get_summary_stats: {
        method: "GET",
        url: "/api?action=get_summary_stats",
        desc: "Mengambil statistik total pasien, pasien kontrol hari ini, reschedule, rujukan habis, dan yang belum terhubung LID.",
        params: [{ name: "action", default: "get_summary_stats", desc: "Aksi get_summary_stats" }]
      }
    };

    let activeKey = "ping";

    function toggleSidebar() {
      const sb = document.getElementById("api-sidebar");
      if (sb) sb.classList.toggle("open");
    }

    function selectEndpoint(key) {
      activeKey = key;
      const ep = ENDPOINTS[key];
      if (!ep) return;

      document.querySelectorAll(".endpoint-item").forEach(item => {
        item.classList.toggle("active", item.getAttribute("onclick").includes(`'${key}'`));
      });

      const sb = document.getElementById("api-sidebar");
      if (sb && window.innerWidth <= 768) sb.classList.remove("open");

      document.getElementById("ep-method").textContent = ep.method;
      document.getElementById("ep-method").className = `method-badge method-${ep.method.toLowerCase()}`;
      document.getElementById("ep-url-display").textContent = ep.url;
      document.getElementById("ep-description").textContent = ep.desc;

      const pContainer = document.getElementById("ep-params-container");
      const postBodyContainer = document.getElementById("ep-post-body-container");

      if (ep.method === "GET") {
        postBodyContainer.style.display = "none";
        pContainer.style.display = "block";
        if (ep.params.length === 0) {
          pContainer.innerHTML = `<p style="color: var(--text-dim); font-size: 12px;">Endpoint ini tidak memerlukan parameter query tambahan.</p>`;
        } else {
          let html = `<table class="params-table"><thead><tr><th style="width:140px;">Parameter</th><th>Nilai</th><th style="width:200px;">Keterangan</th></tr></thead><tbody>`;
          ep.params.forEach(p => {
            html += `
              <tr>
                <td class="font-mono" style="color: var(--accent); font-weight:600;">${p.name}</td>
                <td><input type="text" class="params-input" id="param-${p.name}" value="${p.default}" oninput="updateUrlPreview()"></td>
                <td style="color: var(--text-dim); font-size:11px;">${p.desc}</td>
              </tr>
            `;
          });
          html += `</tbody></table>`;
          pContainer.innerHTML = html;
        }
      } else {
        pContainer.style.display = "none";
        postBodyContainer.style.display = "block";
        document.getElementById("ep-post-body").value = ep.body || "{}";
      }

      updateCodeSnippet();
    }

    function updateUrlPreview() {
      const ep = ENDPOINTS[activeKey];
      if (ep.method !== "GET") return;

      if (activeKey === "health") {
        document.getElementById("ep-url-display").textContent = "/api/health";
        updateCodeSnippet();
        return;
      }

      const queryParts = [];
      ep.params.forEach(p => {
        const input = document.getElementById(`param-${p.name}`);
        const val = input ? input.value : p.default;
        if (val) queryParts.push(`${encodeURIComponent(p.name)}=${encodeURIComponent(val)}`);
      });

      const fullUrl = `/api?${queryParts.join("&")}`;
      document.getElementById("ep-url-display").textContent = fullUrl;
      updateCodeSnippet();
    }

    function updateCodeSnippet() {
      const ep = ENDPOINTS[activeKey];
      const snippetBox = document.getElementById("ep-code-snippet");

      if (ep.method === "GET") {
        const path = document.getElementById("ep-url-display").textContent;
        snippetBox.innerHTML = `// Integrasi JavaScript Bot WA / Node.js\nconst res = await fetch("http://localhost:3000${path}").then(r => r.json());\nconsole.log(res);`;
      } else {
        const body = document.getElementById("ep-post-body").value;
        snippetBox.innerHTML = `// Integrasi POST Request ke Database Portal\nconst res = await fetch("http://localhost:3000/api", {\n  method: "POST",\n  headers: { "Content-Type": "application/json" },\n  body: JSON.stringify(${body.replace(/\n/g, "\n  ")})\n}).then(r => r.json());\nconsole.log(res);`;
      }
    }

    async function executeCurrentRequest() {
      const ep = ENDPOINTS[activeKey];
      const btn = document.getElementById("btn-send-request");
      const jsonViewer = document.getElementById("res-json-output");
      const statusBadge = document.getElementById("res-status-badge");
      const timeSpan = document.getElementById("res-time");

      btn.disabled = true;
      btn.innerHTML = `<i class="fas fa-spinner fa-spin"></i> Mengirim...`;
      jsonViewer.textContent = "Menghubungi server...";

      const startTime = performance.now();

      try {
        let res;
        if (ep.method === "GET") {
          const url = document.getElementById("ep-url-display").textContent;
          res = await fetch(url);
        } else {
          const body = document.getElementById("ep-post-body").value;
          res = await fetch("/api", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: body
          });
        }

        const endTime = performance.now();
        const duration = Math.round(endTime - startTime);

        statusBadge.textContent = `${res.status} ${res.statusText}`;
        statusBadge.className = res.ok ? "badge badge-success" : "badge badge-danger";
        timeSpan.innerHTML = `<i class="fas fa-bolt"></i> ${duration}ms`;

        const data = await res.json();
        jsonViewer.textContent = JSON.stringify(data, null, 2);
        showToast(`Request berhasil (${duration}ms)`);
      } catch (err) {
        statusBadge.textContent = "Error";
        statusBadge.className = "badge badge-danger";
        jsonViewer.textContent = JSON.stringify({ error: err.message }, null, 2);
        showToast(err.message, "error");
      } finally {
        btn.disabled = false;
        btn.innerHTML = `<i class="fas fa-paper-plane"></i> Kirim Request`;
      }
    }

    function copyResponseJson() {
      const text = document.getElementById("res-json-output").textContent;
      navigator.clipboard.writeText(text);
      showToast("JSON respon berhasil disalin ke clipboard!");
    }

    function copyBaseUrl() {
      const base = window.location.origin + "/api";
      navigator.clipboard.writeText(base);
      showToast(`Base URL ${base} disalin!`);
    }

    function showToast(msg, type = "success") {
      const container = document.getElementById("toast-container");
      const toast = document.createElement("div");
      toast.className = `toast toast-${type}`;
      const icon = type === "error" ? "fa-exclamation-triangle" : (type === "info" ? "fa-info-circle" : "fa-check-circle");
      toast.innerHTML = `<i class="fas ${icon}"></i> <span>${msg}</span>`;
      container.appendChild(toast);
      setTimeout(() => {
        toast.style.opacity = "0";
        setTimeout(() => toast.remove(), 300);
      }, 3000);
    }

    // Theme Management (Light, Blue Cyan, Dark)
    function changeTheme(theme) {
      document.documentElement.setAttribute('data-theme', theme);
      localStorage.setItem('rskdgm_theme', theme);
      const sel = document.getElementById('theme-select');
      if (sel) sel.value = theme;
      showToast(`Tema diubah: ${theme === 'light' ? 'Terang (Default)' : (theme === 'blue-cyan' ? 'Blue Cyan Soft' : 'Gelap')}`, 'info');
    }
    const savedTheme = localStorage.getItem('rskdgm_theme') || 'light';
    document.documentElement.setAttribute('data-theme', savedTheme);

    window.addEventListener("DOMContentLoaded", () => {
      const themeSelect = document.getElementById('theme-select');
      if (themeSelect) themeSelect.value = savedTheme;
      selectEndpoint("ping");
      executeCurrentRequest();
    });
  </script>
</body>
</html>
